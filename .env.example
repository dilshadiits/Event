# Copy this file to .env and fill in real values.
# See docs/06-environment-and-hidden-behavior.md for what each one actually controls,
# what breaks if it's missing, and defaults that apply when it's left unset.

# --- Required for the app to run at all ---
MONGODB_URI=

# --- Required for the Competitions module (Super Admin / Event Admin / Judge / Student logins) ---
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:4000
# One-time secret used to create the very first Super Admin account. Discard/rotate after use.
BOOTSTRAP_SECRET=

# --- Required only if you use Google sign-in for Award voting (/awards/[id]/vote) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Required only for phone+OTP flows to actually send SMS ---
# Used by: legacy /vote/[eventId] voting, and the Student Portal login (/student/login).
# Without this, OTP requests fail with "SMS service not configured."
FAST2SMS_API_KEY=

# --- Shared admin password gate (PasswordGate) for /, /events/**, /awards/** ---
# Defaults to admin/super123 if left unset — change these before any real deployment.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Legacy phone-based voting admin bypass (/vote/[eventId] flow only) ---
# A phone number matching this skips OTP entirely. Defaults to a hardcoded number in
# the code if left unset — override this in any real deployment.
ADMIN_PHONE=

# --- Award voting admin identity (/awards/[id]/vote flow only) ---
# A voter whose email OR display name matches these gets a 20x vote weight AND bypasses
# the one-vote-per-category limit. Defaults to admin@example.com / "admin" if unset —
# see the security note in docs/06-environment-and-hidden-behavior.md before relying on this.
ADMIN_EMAIL=
ADMIN_NAME=
